# Terraform version and provider pins.
#
# All Takumi OS infrastructure modules consume these versions.
# Bump these with an ADR when upgrading.

terraform {
  required_version = ">= 1.9.0, < 2.0.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    azuread = {
      source  = "hashicorp/azuread"
      version = "~> 3.0"
    }
    azapi = {
      source  = "Azure/azapi"
      version = "~> 2.0"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 3.0"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.30"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Per [[0003-monorepo-vs-polyrepo]], the state backend is
  # environment-specific Azure Storage. Each env config sets its
  # own backend block; no default backend in this file.
}
