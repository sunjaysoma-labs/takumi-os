<Project>
  <!--
    Shared MSBuild properties for all .NET projects in the Takumi OS monorepo.
    See https://docs.microsoft.com/en-us/visualstudio/msbuild/customize-by-directory
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      NU1902 (vulnerable package) and NU1903 (vulnerable transitive) are
      NOT promoted to errors in M0 because the dev environment is the
      only consumer and the GHSAs flagged so far (GHSA-rpq8-q44m-2rpg on
      Microsoft.Identity.Web 3.x, GHSA-4625-4j76-fww9 on OTel 1.x) apply
      to every 3.x/1.x version currently in the .NET 9 ecosystem.
      Tracking: TKM-M0-007 follow-up — bump to 4.x Identity.Web + 2.x
      OTel in R1 when .NET 9 LTS stabilises those packages. CI job
      Dependency vulnerability scan still surfaces them in the report.
    -->
    <WarningsNotAsErrors>NU1902;NU1903;CS1591;CA1848;CA2264</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591;NU1902;NU1903;CA1848;CA2264</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Centralised versioning -->
    <Version>1.0.0</Version>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- Build hygiene -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>

    <!-- Code coverage -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults\coverage\</CoverletOutput>
    <Threshold>80</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <Exclude>[*.Tests]*,[*.Test*]*</Exclude>
  </PropertyGroup>
</Project>
