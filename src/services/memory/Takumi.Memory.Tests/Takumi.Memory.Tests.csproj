<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Takumi OS Memory Service — unit and integration tests.
      xUnit + FluentAssertions + NSubstitute + Testcontainers.
    </Description>
    <RootNamespace>Takumi.Memory.Tests</RootNamespace>
    <AssemblyName>Takumi.Memory.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Takumi.Memory.Domain\Takumi.Memory.Domain.csproj" />
